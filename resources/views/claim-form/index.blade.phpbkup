		$(document).on("change", ".row-checkbox", function() {
            var id = $(this).val();
            selectedRows[id] = $(this).prop("checked");

            var allChecked = $(".row-checkbox").length && $(".row-checkbox:checked").length === $(".row-checkbox")
                .length;
            $("#selectAll").prop("checked", allChecked);
        });

        $(document).on("change", "#selectAll", function() {
            var checked = $(this).prop("checked");
            $(".row-checkbox").each(function() {
                $(this).prop("checked", checked);
                selectedRows[$(this).val()] = checked;
            });
        });
		
		
		$(document).on("click", "#create_batch", function() {
			let selected = [];
			$(".row-checkbox:checked").each(function() {
				selected.push($(this).val());
			});
			
			$.ajax({
                url: "{{ url('create-batch-claim') }}",
                type: "POST",
                data: {
                    _token: "{{ csrf_token() }}",
                    claim_id: selected,
                    claim_type_id:'{{$claimSlug}}'
                },
                success: function(res) {
				    if(res.status===false){
						toastr.error(res.errors.message);
						return false;
					}
					
                    toastr.success(res.message);
					
                    /*setTimeout(function() {
                        window.location.href = "{{ url('claims') }}";
                    }, 2000);*/
                },
                error: function(xhr) {
                   toastr.error('Some thing wrong!');
                }
            });
			
			//console.log("Selected values:", selected);
		});
		
		
		
		

        $(".filter_btn").on("click", function() {
            const status = $(this).data("val");
            $("#review_status").val(status);
            $(".filter_btn").removeClass("active");
            $(this).addClass("active");
            oTable.draw();
        });


        function viewTHistory(id) {
            return `<a 
			  href="#" data-id="${id}" 
			  class="btn btn-sm btn-warning btn-circle m-1 timeline-request" rel="tooltip" title="History"
			  ><i class="fa fa-history"></i>
			</a>`;
        }
		
		
    </script>
