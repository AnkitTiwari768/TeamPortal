            $("#cancel-btnnn").on("click", function() {
                $("#preview").attr("src", "{{ url('img/preview.png') }}");
                $('#submit-photo-btn').prop("disabled", true);
            });


            $("#photo").on("change", function() {

                var images = $('#photo')[0].files;

                if (images.length > 0) {
                    var formData = new FormData();

                    formData.append('images', images[0]);
                    formData.append('_token', '{{ csrf_token() }}');
                    $.ajax({
                        xhr: function() {
                            var xhr = new window.XMLHttpRequest();
                            xhr.upload.addEventListener("progress", function(element) {},
                                false);
                            return xhr;
                        },
                        url: "{{ url('profilePhoto') }}",
                        method: 'POST',
                        data: formData,
                        contentType: false,
                        processData: false,
                        dataType: 'json',
                        beforeSend: function() {
                            $('.progress').show();
                            $('#loader').html(
                                '<i class="fa fa-spinner fa-spin"></i> <span>wait in processing...</span>'
                            );

                        },
                        success: function(response) {
                            //console.log(response);
                            if (response.status) {
                                var data = response.data;
                                $("#photo_file_upload_id").val(data['id']);
                                $("#preview").attr("src",
                                    "{{ url(config('constant.upload_base_path') . config('constant.user_image_file_path')) }}" +
                                    "/" + data['file_system_name']);
                                $('#submit-photo-btn').prop("disabled", false);
                                toastr.success("Successfully uploaded.");
                                $('.progress').delay(1000).fadeOut('slow');

                            } else {
                                $('.progress').delay(1000).fadeOut('slow');
                                var errors = response.errors;
                                if (response.message) {
                                    toastr.error(response.message);
                                    $('#image').val('');
                                }
                                if (response.errors.images) {
                                    toastr.error(errors.images[0]);
                                    $('#image').val('');
                                }
                                return;
                            }
                        },
                        error: function(response) {
                            //console.log(response.errors);
                        }
                    });
                }
            });

            //Submit photo
            @isset($id)
                $("#photoformId").on("submit", function(event) {
                    event.preventDefault();
                    var uploadImage = document.getElementById("photo").files[0];
                    var photo_file_upload_id = $("#photo_file_upload_id").val();
                    var csrfToken = "{{ csrf_token() }}";
                    var method = 'POST';


                    var url = "{{ url('profile/update-photo/' . $id) }}";
                    var redirectTo = "{{ url('/profile') }}";


                    var formData = new FormData();
                    formData.append("id", "{{ $id }}");
                    formData.append("image", uploadImage);
                    formData.append("photo_file_upload_id", photo_file_upload_id);
                    formData.append("_token", csrfToken);

                    $.ajax({
                        url: url,
                        method: method,
                        data: formData,
                        contentType: false,
                        cache: false,
                        processData: false,
                        success: function(responseData) {
                            if (responseData.status) {
                                success(responseData);
                                redirect(redirectTo);
                            } else if (!responseData.status && responseData.errors) {
                                applyValidationErrors(responseData);
                                enableSubmit();
                                return;
                            } else {
                                failure(responseData);
                                enableSubmit();
                            }
                        },
                        error: function() {
                            $("#spinner").html(
                                '<span class="text-danger">Something went wrong..</span>');
                        }
                    });
                });
            @endisset
        });
    </script>
