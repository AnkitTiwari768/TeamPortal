/* TIMELINE */
.tooltip-ins[download]:hover {
  position: relative;
}
.tooltip-ins[download]:hover:before {
  position: absolute;
    top: calc(100% - 45px);
    left: 50%;
    z-index: 10;
    content: attr(title);
    padding: 4px;
    width: auto;
    overflow: hidden;
    word-wrap: break-word;
    font-size: inherit;
    color: #FFF;
    text-align: center;
    background-color: #222;
    box-sizing: border-box;
    box-shadow: 2px 2px 2px rgba(0, 0, 0, 0.2);
    border-radius: 3px;
    transform: translate(-50%, -50%);
    white-space: nowrap;
    font-size: 10px;
}
.tooltip-ins[download]:hover::after{
  content: '';
  position: absolute;
  width: 0;
  height: 0;
  border-left: 10px solid transparent;
  border-right: 10px solid transparent;
  border-top: 10px solid #222 ;
  top: calc(100% - 32px);
  left: 50%;
  transform: translate(-50%, -50%);
}

