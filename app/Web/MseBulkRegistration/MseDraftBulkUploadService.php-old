						$enterpriseType = strtolower(trim($udetails['BasicDetail']['EnterpriseType'] ?? ''));
						$finalUdyamNo = $udetails['BasicDetail']['UdyamNo'] ?? $udyam_no;

						if ($majorActivity === 'trading' || $enterpriseType === 'medium') {
							$msg = $majorActivity === 'trading'
								? "Registration on the TEAMS Portal is currently restricted for MSMEs engaged in Trading activities."
								: "Medium-scale MSMEs are not eligible for registration on the TEAMS Portal.";

							DB::table('team_msme_scheme_drafts')
								->where('id', $draft->id)
								->update([
									'status' => 'Failed',
									'processed_at' => now()
								]);
							$this->saveTempImportError($payload, $msg);
							DB::commit();
							$failed++;
							continue;
						}

						// ---------- DUPLICATE CHECK ----------
						$exists = DB::table('team_msme_schemes')
							->where('mobile', $mobile)
							->where('udyam_no', $finalUdyamNo)
							->exists();

						if ($exists) {
							DB::table('team_msme_scheme_drafts')
								->where('id', $draft->id)
								->update([
									'status' => 'Migrated',
									'processed_at' => now()
								]);
							DB::commit();
							$success++;
							continue;
						}

						// ---------- INSERT ----------
						$msmeId = uuid();
						$userId = uuid();
						DB::table('team_msme_schemes')->insert($this->prepareMsmeDataIa($payload, $udetails, $msmeId, $userId));
						DB::table('users')->insert($this->prepareUserData($payload, $udetails, $userId, $mobile));

						$roleId = DB::table('roles')->where('slug', 'msme')->value('id');
						DB::table('user_roles')->insert([
							'user_id' => $userId,
							'role_id' => $roleId,
							'type' => GrantType::THROUGH_ROLE
						]);

						// ---------- MARK MIGRATED ----------
						DB::table('team_msme_scheme_drafts')
							->where('id', $draft->id)
							->update([
								'status' => 'Migrated',
								'processed_at' => now()
							]);
						DB::commit();
						$success++;

					} catch (\Exception $e) {
						DB::rollBack();
						DB::table('team_msme_scheme_drafts')
							->where('id', $draft->id)
							->update([
								'status' => 'Failed',
								'processed_at' => now()
							]);
						$this->saveTempImportError($payload, $e->getMessage());
						$failed++;
					}
				}

			}, 'id');

		// ================= NOTIFICATION =================

			//$success = (int)$success;				
			$totalcount = DB::table('team_msme_scheme_drafts')->where('role_type', 2)->where('status', 'Pending')->count();
			$fromUserId = authId();
			$fromRoleId = DB::table('user_roles')->where('user_id', $fromUserId)->value('role_id');
			$toRoleId = DB::table('roles')->where('slug', 'snp')->value('id');
			event(new SendNotificationEvent(
					templateKey: 'pending-mse-transferred-migrated',
					fromUserId: $fromUserId,
					toUserId: null,
					formRole: $fromRoleId,
					toRole: $fromRoleId,
					type: 2,
					message: [
					 'SUCCESS_COUNT' => (string)$success,       
        			 'TOTAL_COUNT'   => (string)$totalcount,
					]
			));
		return [
			'status' => true,
			'success' => $success,
			'failed' => $failed,
			'message' => 'MSME Registration Udyam Process Completed'
		];
	}
    private function prepareMsmeData($payload, $udetails, $uuid, $userId)
	{
		
		$incDate = \DateTime::createFromFormat('d/m/Y', $udetails['BasicDetail']['IncorporationDate'] ?? null);
		return [
			'id' => $uuid,
			'user_id' => $userId,
			//'team_id' => 'TEAM' . rand(10000, 99999),
			'team_id' =>  getNextTeamId() ?: null,
			'udyam_no' => $udetails['BasicDetail']['UdyamNo'],
			'mobile' => trim($payload->get('mobile')),
			'email' => $udetails['BasicDetail']['EmailId'],
			'enterprise_name' => $udetails['BasicDetail']['EnterpriseName'],
			'entrepreneur_name' => $udetails['BasicDetail']['EntrepreneurName'],
			'organisation_type' => $udetails['BasicDetail']['OrganisationType'],
			'address' => $udetails['BasicDetail']['CommunicationAddress'],
			'pincode' => $udetails['BasicDetail']['PINCode'],
			'ph' => $udetails['BasicDetail']['PH'],
			'major_activity' => $udetails['BasicDetail']['MajorActivity'],
			'msme_classification' => $udetails['BasicDetail']['EnterpriseType'],
			'gender' => $udetails['BasicDetail']['Gender'],
			'social_category' => $udetails['BasicDetail']['SocialCategory'],
			'incorporation_date' => $incDate?->format('Y-m-d'),
			'total_emp' => $udetails['BasicDetail']['TotalEmp'],
			'state_id' => $this->getStateId('states', $udetails['BasicDetail']['LG_ST_Code']),
			'district_id' => $this->getStateId('locations', $udetails['BasicDetail']['LG_DT_Code']),
			'enterprise_details' => json_encode($udetails['BasicDetail']['EnterpriseDetail']),
			'activity_details' => isset($udetails['ActivityDetail']) ? json_encode($udetails['ActivityDetail']) : null,
			'gstin_no' => $payload->get('gstin_no') ?? null,
			'pan_no' => $payload->get('pan_no'),
			'turnover' => $payload->get('turnover'),
			'current_state_business_id' => $this->getCurrentBuisinessTypes('attribute_values', slugify($payload->get('current_state_business_id'))),
			'ondc_transaction_type_id' => $this->getTransactionTypes('attribute_values', slugify($payload->get('ondc_transaction_type_id'))),
			'product_category_id' => $this->getSubdomainTypes('sub_domains', $payload['product_category_id']),
			'select_snp' => 1,
			'attending_ondc_awareness_workshop' => strtolower($payload->get('attending_ondc_awareness_workshop')) === 'yes' ? 1 : 0,
			'status' => 1,
			'is_bulk_import' => 1,
			'created_at' => currentDateTime(),
			'updated_at' => currentDateTime(),
			'created_by' => $payload['created_by'],
		];
	}
