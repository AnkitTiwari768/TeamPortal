	public function getStateId($table, $state_code)
    {
        $record = DB::table($table)
            ->where("code", $state_code)
            ->first();
        return $record ? $record->id : null;
    }
    public function getSnpId($authId){
		return DB::table('team_snp_scheme')->where('user_id', $authId)->value('id');
	}
	public function getCurrentBuisinessTypes($table,$state_code)
	{
		 $record = DB::table($table)->where('code',$state_code)->first();
		 return $record ? $record->id : null;
	}
	public function getSubdomainTypes($table, $code)
	{
		$sub = explode(",", $code);
 
		$slugs = collect($sub)->map(function ($item) {
			$item = trim($item);

			if (str_contains($item, '-')) {
				return \Str::slug($item);
			}

			return \Str::slug($item);
		})->filter()->values()->toArray();

		if (count($slugs) > 1) {
			$combinedSlug = implode('-', $slugs);

			$checkCombined = DB::table($table)
				->where('code', $combinedSlug)
				->pluck('id');

			if ($checkCombined->isNotEmpty()) {
				return $checkCombined->toJson();
			}
		}

		$ids = DB::table($table)
			->whereIn('code', $slugs)
			->pluck('id');

		return $ids->isEmpty() ? null : $ids->toJson();
	}
    
